.386
.model flat, stdcall
.stack 4096

ExitProcess   PROTO, dwExitCode:DWORD
GetStdHandle  PROTO, nStdHandle:DWORD
WriteConsoleW PROTO, hOut:DWORD, lpBuf:DWORD, nChars:DWORD, lpWritten:DWORD, lpReserved:DWORD

.data
    ; 출력할 문자열 (한글이 깨지지 않도록 유니코드 값으로 저장, WORD 1개 = 글자 1개)
    msg WORD 0D559h, 0BC88h, ':', ' '                    ; 학번:
        WORD '2','0','2','5','9','6','4','0','2','5'     ; 2025964025
        WORD 0Dh, 0Ah                                    ; 줄바꿈
        WORD 0C774h, 0B984h, ':', ' '                    ; 이름:
        WORD 0C190h, 0C608h, 0C548h                      ; 손예안
        WORD 0Dh, 0Ah                                    ; 줄바꿈
    msgLen = ($ - msg) / 2       ; 전체 글자 수 (바이트 수 / 2)

    hOut    DWORD ?              ; 콘솔 출력 핸들을 저장할 공간
    written DWORD ?              ; 실제로 출력된 글자 수

.code
main PROC
    ; 1. 콘솔 출력 핸들 가져오기
    INVOKE GetStdHandle, -11     ; -11 = STD_OUTPUT_HANDLE
    mov hOut, eax                ; 결과(EAX)를 hOut에 저장

    ; 2. 학번과 이름 출력
    INVOKE WriteConsoleW, hOut, ADDR msg, msgLen, ADDR written, 0

    ; 3. 프로그램 안전 종료
    INVOKE ExitProcess, 0
main ENDP
END main
