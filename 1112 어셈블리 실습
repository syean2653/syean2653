
.386
.model flat, stdcall
.stack 4096

scanf_s PROTO C :PTR BYTE, :PTR DWORD
printf  PROTO C :PTR BYTE, :VARARG

.data
    inputMsg  BYTE "Enter 5 integers:", 13, 10, 0
    promptMsg BYTE "Number %d: ", 0
    inputFmt  BYTE "%d", 0
    resultMsg BYTE 13, 10, "Average = %.2f", 13, 10, 0
    errorMsg  BYTE "Invalid input. Please enter an integer.", 13, 10, 0

    number    SDWORD ?
    count     DWORD 1

    ; 64-bit signed sum
    sumValue  QWORD 0

    five      SDWORD 5
    average   REAL8 ?

.code

main PROC C

    ; Display input message
    INVOKE printf, ADDR inputMsg

INPUT_LOOP:

    ; Display input prompt
    INVOKE printf, ADDR promptMsg, count

    ; Read one integer
    INVOKE scanf_s, ADDR inputFmt, ADDR number

    ; Check input result
    cmp eax, 1
    jne INPUT_ERROR

    ; Add signed 32-bit integer to 64-bit sum
    mov eax, number
    cdq
    add DWORD PTR sumValue, eax
    adc DWORD PTR sumValue+4, edx

    ; Increment counter
    inc count

    ; Repeat until five integers are entered
    cmp count, 6
    jl INPUT_LOOP

    ; Calculate average using x87 FPU
    fild QWORD PTR sumValue
    fidiv DWORD PTR five
    fstp QWORD PTR average

    ; Display average
    INVOKE printf, ADDR resultMsg, DWORD PTR average, DWORD PTR average+4

    ; Return success
    xor eax, eax
    ret

INPUT_ERROR:

    INVOKE printf, ADDR errorMsg

    ; Return failure
    mov eax, 1
    ret

main ENDP

END main

