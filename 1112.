## 9.9.2 Algorithm Workbench

### 1. 32비트 base-index 피연산자 예

```asm
mov eax,[ebx+esi]          ; base(EBX) + index(ESI)
```

### 2. 32비트 base-index-displacement 피연산자 예

```asm
mov eax,array[ebx+esi]     ; displacement(array) + base(EBX) + index(ESI)
mov eax,[ebx+esi+4]        ; 상수 displacement도 가능
```

### 3. 3행 × 4열 더블워드 2차원 배열에서 1행(두 번째 행) 2열(세 번째 열) 접근 (0부터 셈)

```asm
mov esi,16                     ; 행 오프셋 = 1행 × (4열 × 4바이트)
mov edi,2                      ; 열 번호
mov eax,array[esi + edi*4]     ; array + 16 + 8 = array + 24바이트
```

- **풀이:** 한 행은 4개 × 4바이트 = 16바이트. 행 하나를 넘어가려면 16을 더하고, 열은 번호에 4(DWORD 크기)를 곱한다.

### 4. CMPSW로 16비트 배열 sourcew와 targetw 비교

```asm
    mov  esi,OFFSET sourcew
    mov  edi,OFFSET targetw
    mov  ecx,LENGTHOF sourcew   ; 비교할 원소 수
    cld                         ; 앞에서 뒤로
    repe cmpsw                  ; 같은 동안 반복
    je   AllEqual               ; 끝까지 같으면 ZF = 1
    ; 여기로 오면 다른 원소가 있음 (ESI, EDI는 그 다음 원소를 가리킴)
```

### 5. SCASW로 wordArray에서 0100h를 찾아 그 원소의 주소를 EAX에

```asm
    mov  edi,OFFSET wordArray
    mov  ax,0100h               ; 찾을 값
    mov  ecx,LENGTHOF wordArray
    cld
    repne scasw                 ; 일치할 때까지 반복
    jnz  NotFound               ; 끝까지 못 찾으면 ZF = 0
    sub  edi,2                  ; EDI가 일치 원소의 다음을 가리키므로 2바이트 되돌림
    mov  eax,edi                ; EAX = 일치한 원소의 주소
```

### 6. Str_compare로 두 문자열 중 큰 것을 화면에 출력

```asm
    INVOKE Str_compare, ADDR string1, ADDR string2
    ja   S1Bigger               ; string1 > string2 (CF = 0, ZF = 0)
    mov  edx,OFFSET string2     ; string2가 크거나 같음
    jmp  Show
S1Bigger:
    mov  edx,OFFSET string1
Show:
    call WriteString
    call Crlf
```

- **풀이:** Str_compare는 값을 돌려주지 않고 CMP처럼 플래그만 설정한다. string1 < string2면 CF = 1, 같으면 ZF = 1, 크면 둘 다 0이므로 JA를 쓴다.

### 7. Str_trim으로 끝에 붙은 '@'를 모두 지우기

```asm
.data
myString BYTE "Hello@@@",0
.code
INVOKE Str_trim, ADDR myString, '@'     ; myString = "Hello"
```

### 8. Str_ucase를 고쳐 소문자로 바꾸는 Str_lcase

```asm
Str_lcase PROC USES eax esi,
    pString:PTR BYTE
    mov  esi,pString
L1: mov  al,[esi]                      ; 문자 하나
    cmp  al,0                          ; 문자열 끝?
    je   L3
    cmp  al,'A'                        ; 'A'보다 작으면 건너뜀
    jb   L2
    cmp  al,'Z'                        ; 'Z'보다 크면 건너뜀
    ja   L2
    or   BYTE PTR [esi],00100000b      ; 비트 5를 켜면 소문자
L2: inc  esi
    jmp  L1
L3: ret
Str_lcase ENDP
```

- **바뀐 곳:** 비교 범위 'a'~'z' → 'A'~'Z', `and ...,11011111b`(비트 5 끄기) → `or ...,00100000b`(비트 5 켜기).

### 9. 64비트 Str_trim

교재 9.3.7의 64비트 프로시저처럼 레지스터로 매개변수를 받는다. 64비트 Str_length는 RCX로 주소를 받아 RAX로 길이를 돌려준다.

```asm
;-------------------------------------------------------
; Str_trim (64비트)
; 문자열 끝에 붙은 지정 문자를 모두 지운다.
; Receives: RCX = 문자열 주소, DL = 지울 문자
; Returns:  없음
;-------------------------------------------------------
Str_trim PROC USES rax rcx rdi
    mov  rdi,rcx            ; RDI = 문자열 시작
    call Str_length         ; RAX = 길이 (RCX의 문자열)
    cmp  rax,0
    je   L3                 ; 빈 문자열이면 끝
    mov  rcx,rax            ; RCX = 길이 (64비트 LOOP 카운터)
    dec  rax
    add  rdi,rax            ; RDI = 마지막 문자
L1: mov  al,[rdi]
    cmp  al,dl              ; 지울 문자인가?
    jne  L2                 ; 아니면 그 뒤에 null을 넣으러
    dec  rdi                ; 맞으면 한 칸 앞으로
    loop L1
L2: mov  BYTE PTR [rdi+1],0 ; null 삽입
L3: ret
Str_trim ENDP
```

### 10. 64비트 base-index 피연산자 예

```asm
mov rax,[rbx+rsi]          ; 64비트 모드에서는 64비트 레지스터를 써야 한다
```

### 11. EBX = 행, EDI = 열일 때 32비트 2차원 배열 원소를 EAX로 (한 문장)

```asm
mov eax,myArray[ebx + edi*TYPE myArray]
```

- **풀이:** 교재 9.4.3 예제처럼 EBX에는 행 번호에 행 크기(바이트)를 곱한 **행 오프셋**이 들어 있다고 본다. 스케일 팩터는 1, 2, 4, 8만 가능하므로 행 번호 그대로라면 먼저 행 크기를 곱해 둬야 한다.

### 12. RBX = 행, RDI = 열일 때 64비트 2차원 배열 원소를 RAX로 (한 문장)

```asm
mov rax,myArray[rbx + rdi*TYPE myArray]    ; TYPE myArray = 8
```
