## 10.7.2 Algorithm Workbench

### 1. 구조체 SampleStruct (WORD 1개 + DWORD 20개 배열)

```asm
SampleStruct STRUCT
    field1 WORD ?
    field2 DWORD 20 DUP(?)
SampleStruct ENDS
```

### 2. SYSTEMTIME 구조체의 wHour 필드 가져오기

```asm
.data
sysTime SYSTEMTIME <>
.code
INVOKE GetLocalTime, ADDR sysTime   ; 현재 시각 채우기
mov ax,sysTime.wHour                 ; wHour는 WORD
```

### 3. Triangle 변수를 꼭짓점 (0,0), (5,0), (7,6)으로 초기화

```asm
Triangle STRUCT
    Vertex1 COORD <>
    Vertex2 COORD <>
    Vertex3 COORD <>
Triangle ENDS

.data
myTriangle Triangle < <0,0>, <5,0>, <7,6> >
```

- **풀이:** 구조체 안의 구조체(COORD)는 꺾쇠괄호를 한 번 더 써서 초기화한다. COORD는 X, Y 두 WORD 필드다.

### 4. Triangle 배열의 Vertex1을 0~10 범위의 난수 좌표로 초기화

```asm
.data
NumTriangles = 10
triangles Triangle NumTriangles DUP(<>)
.code
    call Randomize                  ; 난수 시드 초기화
    mov  esi,OFFSET triangles
    mov  ecx,NumTriangles
L1: mov  eax,11                     ; RandomRange(11) → 0~10
    call RandomRange
    mov  (Triangle PTR [esi]).Vertex1.X,ax
    mov  eax,11
    call RandomRange
    mov  (Triangle PTR [esi]).Vertex1.Y,ax
    add  esi,TYPE Triangle          ; 다음 삼각형 (12바이트)
    loop L1
```

- **풀이:** RandomRange는 0 ~ n−1을 주므로 0~10을 얻으려면 11을 넣는다. `(Triangle PTR [esi])`로 ESI가 가리키는 곳을 구조체로 보고 필드에 접근한다.

### 5. 문자를 n번 출력하는 mPrintChar

```asm
mPrintChar MACRO char, count
    LOCAL L1                ;; 호출마다 고유한 레이블
    push eax
    push ecx
    mov  al,char
    mov  ecx,count
L1: call WriteChar          ;; AL의 문자 출력
    loop L1
    pop  ecx
    pop  eax
ENDM

; 호출 예
mPrintChar 'X',20
```

### 6. 0 ~ n−1 난수를 만드는 mGenRandom

```asm
mGenRandom MACRO n
    mov  eax,n
    call RandomRange        ;; EAX = 0 ~ n-1
ENDM

; 호출 예
mGenRandom 100              ; EAX = 0~99
```

### 7. 안내문을 출력하고 정수를 입력받는 mPromptInteger

```asm
mPromptInteger MACRO prompt, returnVal
    push eax
    mWrite prompt           ;; 문자열 리터럴 출력 (교재 매크로)
    call ReadInt            ;; EAX = 입력한 정수
    mov  returnVal,eax
    pop  eax
ENDM

; 호출 예
.data
minVal DWORD ?
.code
mPromptInteger "Enter the minimum value", minVal
```

### 8. 커서를 옮기고 문자열을 출력하는 mWriteAt

```asm
mWriteAt MACRO X, Y, literal
    mGotoxy X, Y            ;; 커서 이동 (교재 매크로)
    mWrite literal          ;; 문자열 출력 (교재 매크로)
ENDM

; 호출 예
mWriteAt 10, 5, "Hello"
```

### 9. `mWriteStr namePrompt`의 전개 결과 (교재 10.2.5의 mWriteString 매크로)

```asm
push edx
mov  edx,OFFSET namePrompt
call WriteString
pop  edx
```

### 10. `mReadStr customerName`의 전개 결과 (교재 10.2.5의 mReadString 매크로)

```asm
push ecx
push edx
mov  edx,OFFSET customerName
mov  ecx,SIZEOF customerName
call ReadString
pop  edx
pop  ecx
```

### 11. 변수 이름 하나만 받는 mDumpMemx

```asm
mDumpMemx MACRO varName
    mDumpMem OFFSET varName, LENGTHOF varName, TYPE varName
ENDM

; 호출 예
.data
array DWORD 10h,20h,30h,40h
.code
mDumpMemx array             ; 주소, 개수 4, 단위 크기 4로 메모리 덤프
```

### 12. 기본 인자(default argument initializer)를 가진 매크로 매개변수

```asm
mWriteln MACRO text:=<" ">   ;; 인자를 생략하면 공백 한 칸
    mWrite text
    call Crlf
ENDM

mWriteln "Hello"             ; "Hello" 출력 후 줄바꿈
mWriteln                     ; 공백 출력 후 줄바꿈
```

- **문법:** `매개변수이름:=<기본값>`

### 13. IF, ELSE, ENDIF 예

```asm
DEBUG = 1

IF DEBUG EQ 1
    call DumpRegs            ; DEBUG가 1일 때만 이 줄이 어셈블됨
ELSE
    nop                      ; 그 외에는 이 줄이 어셈블됨
ENDIF
```

### 14. 매크로 상수 매개변수 Z가 0보다 작으면 어셈블 중에 경고 출력

```asm
mCheckZ MACRO Z
    IF Z LT 0
        ECHO **** Error: Z is invalid (less than zero) ****
        EXITM                ;; 이후 코드 전개 중단
    ENDIF
    ;; ... Z를 쓰는 코드 ...
ENDM
```

### 15. 문자열 리터럴 안에 매개변수를 넣는 & 연산자 예

```asm
mShowName MACRO varName
    mWrite "Variable: &varName"
ENDM

mShowName count             ; 실행하면 "Variable: count" 출력
```

- **풀이:** &가 없으면 "Variable: varName"이 글자 그대로 출력된다.

### 16. mLocate 매크로의 전개 결과

```asm
mLocate MACRO xval,yval
    IF xval LT 0         ;; xval < 0?
        EXITM            ;; if so, exit
    ENDIF
    IF yval LT 0         ;; yval < 0?
        EXITM            ;; if so, exit
    ENDIF
    mov bx,0             ;; video page 0
    mov ah,2             ;; locate cursor
    mov dh,yval
    mov dl,xval
    int 10h              ;; call the BIOS
ENDM
```

**(a) `mLocate -2,20`**

- **답:** 아무 코드도 만들어지지 않는다. xval = −2 < 0이라 EXITM으로 매크로를 바로 빠져나간다.

**(b) `mLocate 10,20`**

```asm
mov bx,0
mov ah,2
mov dh,20
mov dl,10
int 10h
```

**(c) `mLocate col,row`** (col, row는 BYTE 변수)

```asm
mov bx,0
mov ah,2
mov dh,row
mov dl,col
int 10h
```

- **주의:** 교재 10.3.4에 따르면 IF 식에는 변수 이름을 쓸 수 없다. 그래서 실제 MASM에서는 `IF col LT 0`에서 "constant expected" 오류가 날 수 있다. 위 코드는 IF 검사를 통과했다고 볼 때의 전개 결과이고, 문제가 의도한 답이다.
